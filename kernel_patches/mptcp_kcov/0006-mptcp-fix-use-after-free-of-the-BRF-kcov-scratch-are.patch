From faedd54304af9703c536475bfe00f7325689b46e Mon Sep 17 00:00:00 2001
From: Shardul Bankar <shardul.b@mpiricsoftware.com>
Date: Fri, 22 May 2026 03:20:02 +0530
Subject: [PATCH] mptcp: fix use-after-free of the BRF kcov scratch area

A fuzz run oopsed:

  BUG: unable to handle page fault for address: ffffc900...
  RIP: kcov_remote_start_prealloc+0x212 kernel/kcov.c:1021
   mptcp_incoming_options net/mptcp/options.c:1195

kcov.c:1021 is "*(u64 *)area = 0" -- the coverage-count reset.
`area` is msk->kcov_coverage_area, and the faulting address is a
vmalloc page with PTE 0: the area had been freed while RX option
parsing still referenced it.

The BRF kcov scratch area (added by "mptcp: add kcov_remote_handle
fields + MPTCP_KCOV_HANDLE") had three lifetime holes:

  - sk_clone_lock() memcpy's the kcov fields into accepted msks, so
    a cloned msk could hold a pointer to an area owned by another
    msk and outlive it.
  - the area was vfree()'d synchronously, racing in-flight softirq
    option parsing that had already loaded the pointer.
  - BRF_MPTCP_KCOV_START read kcov_coverage_area twice (guard, then
    call), so a concurrent destroy could make it pass a stale or
    NULL pointer.

Fix all three:

  - mptcp_sk_clone_init() clears the memcpy-inherited kcov fields,
    so every area is referenced by exactly one msk.
  - free the area with kvfree_rcu() instead of vfree() (and
    allocate with kvmalloc() to match): an in-flight softirq that
    snapshotted the pointer completes its RCU grace period before
    the memory is freed.
  - BRF_MPTCP_KCOV_START snapshots kcov_coverage_area once.

CONFIG_KCOV-gated test instrumentation only; no effect on a
production build.

Assisted-by: Claude:claude-opus-4-7
Signed-off-by: Shardul Bankar <shardul.b@mpiricsoftware.com>
---
 net/mptcp/protocol.c | 25 ++++++++++++++++++++-----
 net/mptcp/protocol.h | 16 +++++++++++-----
 net/mptcp/sockopt.c  | 10 ++++++----
 3 files changed, 37 insertions(+), 14 deletions(-)

diff --git a/net/mptcp/protocol.c b/net/mptcp/protocol.c
index d71d3073f61a7..bdd2ef3027d45 100644
--- a/net/mptcp/protocol.c
+++ b/net/mptcp/protocol.c
@@ -3571,6 +3571,19 @@ struct sock *mptcp_sk_clone_init(const struct sock *sk,
 		mptcp_copy_ip_options(nsk, sk);
 
 	msk = mptcp_sk(nsk);
+
+#ifdef CONFIG_KCOV
+	/* sk_clone_lock() memcpy'd the listener's BRF kcov fields into
+	 * this accepted msk.  The kcov scratch area is owned by exactly
+	 * one msk -- do NOT inherit the pointer, or this msk would hold
+	 * a dangling reference once the owner frees it.  The harness
+	 * sets the handle explicitly per msk if it wants coverage here.
+	 */
+	msk->kcov_remote_handle = 0;
+	msk->kcov_coverage_area = NULL;
+	msk->kcov_area_size = 0;
+	msk->kcov_owner = NULL;
+#endif
 	WRITE_ONCE(msk->local_key, subflow_req->local_key);
 	WRITE_ONCE(msk->token, subflow_req->token);
 	msk->in_accept_queue = 1;
@@ -3633,13 +3646,15 @@ static void mptcp_destroy(struct sock *sk)
 	sk_sockets_allocated_dec(sk);
 
 #ifdef CONFIG_KCOV
-	/* sk_clone_lock() memcpy's our kcov fields into accepted
-	 * msks; only the msk that called setsockopt(MPTCP_KCOV_HANDLE)
-	 * (and is therefore == kcov_owner) actually owns the area.
-	 * The other (cloned) msks just clear their dangling references.
+	/* The kcov scratch area belongs to exactly one msk -- the one
+	 * that called setsockopt(MPTCP_KCOV_HANDLE).  Accepted msks
+	 * clear the memcpy-inherited fields in mptcp_sk_clone_init(),
+	 * so kcov_owner == msk holds whenever an area is present.
+	 * Free it deferred via RCU so an in-flight softirq that already
+	 * snapshotted the area pointer cannot write to it after free.
 	 */
 	if (msk->kcov_coverage_area && msk->kcov_owner == msk)
-		vfree(msk->kcov_coverage_area);
+		kvfree_rcu_mightsleep(msk->kcov_coverage_area);
 	msk->kcov_coverage_area = NULL;
 	msk->kcov_area_size = 0;
 	msk->kcov_remote_handle = 0;
diff --git a/net/mptcp/protocol.h b/net/mptcp/protocol.h
index 409c960c80374..218c65cdceefc 100644
--- a/net/mptcp/protocol.h
+++ b/net/mptcp/protocol.h
@@ -1462,15 +1462,21 @@ static inline void mptcp_join_cookie_init(void) {}
 #define BRF_MPTCP_KCOV_START(__msk)					\
 	do {								\
 		struct mptcp_sock *__m = (__msk);			\
+		void *__a;						\
+		size_t __sz;						\
 		u64 __h;						\
 		if (!__m)						\
 			break;						\
+		/* snapshot the area pointer once: a concurrent		\
+		 * mptcp_destroy() may NULL it between the guard	\
+		 * and the call.  kvfree_rcu() keeps __a valid		\
+		 * for the duration of this softirq.			\
+		 */							\
 		__h = READ_ONCE(__m->kcov_remote_handle);		\
-		if (__h && __m->kcov_coverage_area &&			\
-		    in_serving_softirq())				\
-			kcov_remote_start_prealloc(__h,			\
-				__m->kcov_coverage_area,		\
-				__m->kcov_area_size);			\
+		__a = READ_ONCE(__m->kcov_coverage_area);		\
+		__sz = READ_ONCE(__m->kcov_area_size);			\
+		if (__h && __a && in_serving_softirq())			\
+			kcov_remote_start_prealloc(__h, __a, __sz);	\
 	} while (0)
 #define BRF_MPTCP_KCOV_STOP(__msk)					\
 	do {								\
diff --git a/net/mptcp/sockopt.c b/net/mptcp/sockopt.c
index 67d99cabf241e..e683e2b85638e 100644
--- a/net/mptcp/sockopt.c
+++ b/net/mptcp/sockopt.c
@@ -927,17 +927,19 @@ static int mptcp_setsockopt_kcov_handle(struct mptcp_sock *msk,
 		return -EFAULT;
 
 	if (handle) {
-		area = vmalloc(MPTCP_KCOV_AREA_SIZE);
+		area = kvmalloc(MPTCP_KCOV_AREA_SIZE, GFP_KERNEL);
 		if (!area)
 			return -ENOMEM;
 	}
 
 	lock_sock((struct sock *)msk);
-	/* Only free if we own the previous area (the field may have
-	 * been memcpy'd from a listener msk via sk_clone_lock).
+	/* Free the previous area (if any) deferred via RCU, so an
+	 * in-flight softirq that already snapshotted the pointer is
+	 * safe.  kcov_owner == msk always holds here (accepted msks
+	 * clear the inherited fields in mptcp_sk_clone_init()).
 	 */
 	if (msk->kcov_coverage_area && msk->kcov_owner == msk)
-		vfree(msk->kcov_coverage_area);
+		kvfree_rcu_mightsleep(msk->kcov_coverage_area);
 	msk->kcov_coverage_area = area;
 	msk->kcov_area_size = area ? MPTCP_KCOV_AREA_SIZE : 0;
 	msk->kcov_owner = area ? msk : NULL;

