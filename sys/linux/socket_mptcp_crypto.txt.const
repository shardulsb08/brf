# Harness-internal constants for MPTCP MP_JOIN pseudo-syscalls.
# DO NOT EDIT BY HAND -- these must mirror the #defines in
# executor/common_brf_linux_mptcp.h.  Values are arch-independent
# (no kernel uapi constants here).
arches = 386, amd64, arm, arm64, mips64le, ppc64le, riscv64, s390x
